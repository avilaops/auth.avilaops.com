# Banco (Postgres do VPS de produção)
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/avilaops-auth"

# Credenciais do OAuth client "Avila Ops SSO" (projeto avila-ops-sso).
# A redirect URI registrada no Google Console precisa ser exatamente:
#   https://auth.avilaops.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base pública deste serviço — usada para montar a redirect URI.
SSO_BASE_URL=https://auth.avilaops.com

# Segredo que assina o cookie de sessão. Gerar com:
#   openssl rand -hex 32
# O MESMO valor precisa estar em todo app que for validar o cookie localmente.
SSO_JWT_SECRET=

# Domínio do cookie compartilhado. O ponto na frente é o que faz o navegador
# mandar o cookie para todos os subdomínios.
# Em dev (localhost) deixar VAZIO — senão o navegador recusa o cookie.
SSO_COOKIE_DOMAIN=.avilaops.com

# Banco do app.avilaops.com (chama-se `cliente_portal` por herança): onde vivem
# as contas em `portal_clients`. O painel /admin edita esta tabela; o usuário do
# Postgres precisa de escrita.
PORTAL_DATABASE_URL=postgresql://usuario:senha@host.docker.internal:5432/cliente_portal

# Opcional. E-mails (vírgula) que podem abrir /admin. Vazio = todo ADMIN.
SSO_SUPERADMINS=nicolas@avilaops.com

# Chave que cifra os client secrets dos conectores de login E os segredos TOTP
# da verificação em duas etapas (AES-256-GCM).
# Gerar com: openssl rand -hex 32. Perder a chave = reconfigurar os conectores e
# recadastrar o segundo fator de todo mundo. SEM ELA a exigência de 2FA fica
# suspensa (ninguém conseguiria cadastrar) e o painel avisa em vermelho.
AUTH_ENCRYPTION_KEY=

# Verificação em duas etapas da equipe: "obrigatorio" (padrão) ou "opcional".
# "opcional" serve para a janela de migração — quem já ativou continua sendo
# desafiado de qualquer jeito, porque fator ativo nunca deixa de valer.
MFA_EQUIPE=obrigatorio

# Banco do avila-mail (somente leitura): valida a senha da caixa de e-mail para
# clientes que só compraram e-mail e não têm conta em portal_clients.
# host.docker.internal alcança o Postgres do host a partir do container.
MAIL_DATABASE_URL=postgresql://avila_mail:senha@host.docker.internal:5432/avila_mail

# Automação de caixa de e-mail (fluxo "Auth — Criar caixa de e-mail" no n8n).
# Ao criar uma conta pelo painel, o auth manda o pedido para cá e o n8n cria a
# caixa no mail.avilaops.com. Sem as duas variáveis, a opção falha com aviso.
N8N_CAIXA_WEBHOOK_URL=https://n8n.avilaops.com/webhook/auth-criar-caixa
N8N_CAIXA_WEBHOOK_TOKEN=
# O mesmo token serve o envio de e-mail pelo n8n (fluxo "Auth - Enviar e-mail",
# em .../webhook/auth-enviar-email): quando não há SMTP_* aqui, convites e o
# cadastro em /criar saem por lá, pela credencial de SMTP guardada no n8n. Só
# defina N8N_EMAIL_WEBHOOK_URL se o fluxo estiver em outro endereço.
# N8N_EMAIL_WEBHOOK_URL=

# Envio de e-mail (src/lib/email.ts): confirma o endereço de quem cria a própria
# conta em /criar. Sem SMTP_HOST, SMTP_USUARIO, SMTP_SENHA e EMAIL_REMETENTE, o
# cadastro por e-mail fica desligado e o link "Criar conta" só aparece se houver
# entrada social configurada.
SMTP_HOST=
SMTP_PORTA=465
SMTP_TLS_DIRETO=1
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Avila Ops

# Segredo de cada cliente OIDC de src/lib/oidc.ts (openssl rand -hex 32). O mesmo valor vai no app cliente.
OIDC_SEGREDO_NOTAS=
OIDC_SEGREDO_TMS=
